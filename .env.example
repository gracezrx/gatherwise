# Private server-side key. Do not expose this in browser code.
GOOGLE_PLACES_API_KEY=

# Optional public URL used by deploy previews and share links.
NEXT_PUBLIC_GATHERWISE_CANONICAL_URL=https://gatherwise.gracezrx.com

# Optional hosted persistence for shared deployments.
# Use Vercel KV or Upstash Redis REST credentials.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Or:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Local development only. Leave unset in shared deployments.
# GATHERWISE_ALLOW_LOCAL_CONFIG=true
